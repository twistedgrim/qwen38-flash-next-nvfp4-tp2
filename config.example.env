# Copy to config.env on the head node. This file contains no credentials.
MODEL_ID=RadixArk/Qwen3.8-Flash-Next-NVFP4
MODEL_REVISION=7b719225242aacd3dbd3f9407468c2ee9a9d2594
MODEL_HOST_PATH=/home/replace-me/models/Qwen3.8-Flash-Next-NVFP4
WORKER_MODEL_HOST_PATH=/home/replace-me/models/Qwen3.8-Flash-Next-NVFP4
MODEL_CONTAINER_PATH=/models/qwen38-flash-next-nvfp4

# Immutable ARM64 image validated with the checkpoint above.
IMAGE=lmsysorg/sglang@sha256:12d3392bdc8be8d35e9a95f191df6aef99c5114bdbefd41bfdc7e760e6d25ec1
CONTAINER_NAME=qwen38_flash_next_nvfp4_tp2
SERVED_MODEL_NAME=qwen3.8-flash-next-nvfp4
PORT="${QWEN38_PORT:-30000}"

# The recipe runs on the head and reaches the worker over SSH.
WORKER_SSH_HOST=replace-me@192.168.1.22
WORKER_FABRIC_SSH_HOST=replace-me@10.76.0.2
WORKER_RECIPE_DIR=/home/replace-me/src/qwen38-flash-next-nvfp4-tp2
HEAD_FABRIC_IP=10.76.0.1
WORKER_FABRIC_IP=10.76.0.2
FABRIC_INTERFACE=enp1s0f0np0
MASTER_PORT=5000

# RoCE is validated. Set QWEN38_NCCL_TRANSPORT=socket for rollback.
QWEN38_NCCL_TRANSPORT="${QWEN38_NCCL_TRANSPORT:-roce}"
NCCL_IB_HCA=rocep1s0f0
NCCL_IB_GID_INDEX=3
NCCL_IB_ROCE_VERSION_NUM=2
NCCL_NET_PLUGIN=none
NCCL_NVLS_ENABLE=0
NCCL_CUMEM_ENABLE=0

# Validated production profile.
QWEN38_CONTEXT_LENGTH="${QWEN38_CONTEXT_LENGTH:-262144}"
QWEN38_MEM_FRACTION="${QWEN38_MEM_FRACTION:-0.80}"
QWEN38_MAX_RUNNING_REQUESTS="${QWEN38_MAX_RUNNING_REQUESTS:-4}"
QWEN38_CHUNKED_PREFILL_SIZE="${QWEN38_CHUNKED_PREFILL_SIZE:-4096}"
QWEN38_MAMBA_TRACK_INTERVAL="${QWEN38_MAMBA_TRACK_INTERVAL:-64}"
QWEN38_MAX_TOTAL_TOKENS="${QWEN38_MAX_TOTAL_TOKENS:-}"
QWEN38_MAX_MAMBA_CACHE_SIZE="${QWEN38_MAX_MAMBA_CACHE_SIZE:-}"
QWEN38_ENABLE_CACHE_REPORT="${QWEN38_ENABLE_CACHE_REPORT:-0}"

# Experimental only. MTP is disabled because long-context canaries found
# intermittent token-ID-0 corruption. Do not promote without rerunning all gates.
QWEN38_ENABLE_MTP="${QWEN38_ENABLE_MTP:-0}"
QWEN38_MTP_NUM_STEPS="${QWEN38_MTP_NUM_STEPS:-3}"
QWEN38_MTP_TOPK="${QWEN38_MTP_TOPK:-1}"
QWEN38_MTP_NUM_DRAFT_TOKENS="${QWEN38_MTP_NUM_DRAFT_TOKENS:-4}"
QWEN38_MTP_ATTENTION_MODE="${QWEN38_MTP_ATTENTION_MODE:-}"

CACHE_HOST_ROOT=/home/replace-me/.cache
READY_TIMEOUT_SECONDS="${QWEN38_READY_TIMEOUT_SECONDS:-1200}"
